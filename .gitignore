# MeshkitKeen — .gitignore
# Исключаем всё, что может содержать секреты или локальные данные.

# Реальный конфиг с доменом/настройками (хранится только на устройстве)
conf/meshkitkeen.conf
MeshkitKeen.conf

# SSH-ключи (приватные) — никогда не коммитить
*.key
*.pem
id_*
authorized_keys

# Временные и отладочные файлы
*.log
*.tmp
*_probe*.json
*.tar.gz
*.bin

# Локальные резервные копии
*.bak
*~
.DS_Store
